# Скопируйте в .env для локального запуска. Не публикуйте этот файл.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
TELEGRAM_BOT_TOKEN=123456:your_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_32_or_more_random_characters
SETUP_KEY=another-long-random-secret
SITE_URL=https://your-service.onrender.com
PUBLIC_CONTACT=Обратитесь к ответственному сотруднику МБОУ СОШ №2
# Для локального запуска:
DATA_DIR=./instance
UPLOAD_DIR=./instance/uploads
